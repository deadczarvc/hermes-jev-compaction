{
  "name": "hermes-jev-compaction",
  "version": "0.90.0",
  "description": "Jev-powered compaction for Hermes Agent: every tool call scored by the Jev decision model (TypeSafe), stale context dropped, everything kept stays verbatim.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hermes": {
      "types": "./dist/hermes.d.ts",
      "import": "./dist/hermes.js"
    }
  },
  "bin": {
    "hermes-compact": "bin/hermes-compact.mjs"
  },
  "files": [
    "dist",
    "bin",
    "hermes-plugin/__init__.py",
    "hermes-plugin/egress.py",
    "hermes-plugin/settings.py",
    "hermes-plugin/value_select.py",
    "hermes-plugin/plugin.yaml",
    "README.md",
    "LICENSE",
    "HERMES.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
